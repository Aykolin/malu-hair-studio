# Observability providers are optional and initialize only when configured.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_VERSION=local

NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com

# JSON copied from the New Relic Browser application's NREUM options.
NEXT_PUBLIC_NEW_RELIC_OPTIONS=

# Example: https://otel-collector.example.com/v1/traces
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=

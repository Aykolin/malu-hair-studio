{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "app/**",
      "components/map-embed.tsx",
      "components/observability.tsx",
      "components/reveal.tsx",
      "tests/**",
      "playwright.config.ts",
      "vitest.config.ts",
      "vitest.setup.ts",
      "stryker.config.mjs",
      "commitlint.config.mjs",
      "biome.json",
      "knip.json",
      "package.json",
      "public/favicon.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
